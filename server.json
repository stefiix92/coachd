{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.stefiix92/coachd",
  "title": "coachd",
  "description": "Self-hosted gateway: your Garmin data over MCP, passkey-approved workouts to your Garmin watch.",
  "version": "0.5.0",
  "websiteUrl": "https://stefiix92.github.io/coachd/",
  "repository": {
    "url": "https://github.com/stefiix92/coachd",
    "source": "github",
    "id": "1432354923"
  },
  "icons": [
    {
      "src": "https://stefiix92.github.io/coachd/images/coachd-icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{host}/mcp",
      "variables": {
        "host": {
          "description": "Host name of your own coachd instance (self-hosted, one per runner)",
          "isRequired": true,
          "placeholder": "coachd.example.com"
        }
      }
    }
  ]
}
